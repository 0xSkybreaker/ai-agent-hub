# NVIDIA NIM API (Required)
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Model Selection
CHAT_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5

# Vector Store
CHROMA_PERSIST_DIR=./data/chroma
COLLECTION_NAME=documents

# Chunking Parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval
TOP_K=5
SIMILARITY_THRESHOLD=0.7

# Generation
MAX_TOKENS=2048
TEMPERATURE=0.1
STREAMING=true

# API Server
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["*"]

# Logging
LOG_LEVEL=INFO

# Document Tracker
TRACKER_DB_PATH=./data/tracker.db
