# NVIDIA NIM API
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
CHAT_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5

# Agent
MAX_STEPS=15
TEMPERATURE=0.1
MAX_TOKENS=2048

# Retrieval
TOP_K=5
SIMILARITY_THRESHOLD=0.0

# ChromaDB — share data with 02-rag-agent by default
CHROMA_PERSIST_DIR=../02-rag-agent/data/chroma
COLLECTION_NAME=documents

# API Server (different port from rag-agent)
HOST=127.0.0.1
PORT=8001
